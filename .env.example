APP_ENV=development
APP_NAME=Movie Booking
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://movie_booking:movie_booking@localhost:5432/movie_booking
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=3600
BCRYPT_ROUNDS=12
# Dev/test seed only (scripts/seed.py); demo credentials, not secrets.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=admin12345
HOLD_TTL_SECONDS=300
MAX_ACTIVE_HOLDS=3
DB_POOL_SIZE=10
WEB_WORKERS=1
ANYIO_THREAD_TOKENS=40
CINEMA_TIMEZONE=Asia/Ho_Chi_Minh
